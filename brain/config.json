{
    "model": {
        "vocab_size": 3000,
        "d_model": 128,
        "num_heads": 4,
        "num_layers": 4,
        "max_seq_len": 256,
        "dropout": 0.1
    },
    "training": {
        "batch_size": 32,
        "learning_rate": 0.0003,
        "max_epochs": 50,
        "eval_every": 500,
        "save_every": 1000,
        "warmup_steps": 100,
        "grad_clip": 1.0
    },
    "data": {
        "train_split": 0.9,
        "val_split": 0.1,
        "tokenizer_path": "data/tokenizer",
        "clean_data_path": "data/clean"
    },
    "paths": {
        "checkpoints": "checkpoints",
        "brain": "brain"
    },
    "version": "0.1.0",
    "name": "JARVIS"
}